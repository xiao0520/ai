# Example only. Do not overwrite an existing production config.env: it contains live secrets.
# For the migrated server, use update-production-env.py to merge known values and preserve secrets.

# Shared runtime
SPRING_PROFILES_ACTIVE=prod
RUOYI_JAVA_PORT=56039
MJN_PYTHON_PORT=58000
MJN_WEB_PORT=50080
MJN_ADMIN_PORT=58080

# Java database connection
RUOYI_MYSQL_HOST=127.0.0.1
RUOYI_MYSQL_PORT=51206
RUOYI_MYSQL_DATABASE=ruoyi-ai
RUOYI_MYSQL_USERNAME=root
RUOYI_MYSQL_PASSWORD='replace-with-mysql-password'

# Java Redis connection
RUOYI_REDIS_HOST=127.0.0.1
RUOYI_REDIS_PORT=56379
RUOYI_REDIS_PASSWORD=''

# Java security
RUOYI_JWT_SECRET_KEY='replace-with-a-random-jwt-secret'
RUOYI_MYBATIS_ENCRYPTOR_PASSWORD=''
RUOYI_MYBATIS_ENCRYPTOR_PUBLIC_KEY=''
RUOYI_MYBATIS_ENCRYPTOR_PRIVATE_KEY=''

# Java to Python internal API
AI_PYTHON_BASE_URL=http://127.0.0.1:58000
AI_INTERNAL_SERVICE_TOKEN='replace-with-a-random-internal-service-token'
AI_INTERNAL_SIGNING_KEY='replace-with-a-random-hmac-signing-key'
AI_PYTHON_CONNECT_TIMEOUT=10s
AI_PYTHON_REQUEST_TOTAL_TIMEOUT=300s
AI_CHAT_HISTORY_MAX_MESSAGES=20

# Python AI service
AI_ENVIRONMENT=prod
AI_INTERNAL_AUTH_MAX_AGE_SECONDS=300
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_PROVIDER_KEEPALIVE_SECONDS=10
AI_PROVIDER_CREDENTIALS='{}'

# Docker production: Java and Python share host networking.
AI_KAFKA_ENABLED=true
AI_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:59092
AI_KNOWLEDGE_INTERNAL_HTTP_ENABLED=true
AI_JAVA_INTERNAL_BASE_URL=http://127.0.0.1:56039
AI_QDRANT_URL=http://127.0.0.1:56333
# The updater reads the live key from /etc/mjn-ai/qdrant/qdrant.env.
# AI_QDRANT_API_KEY=
