# 仅配置部署必须值；模型业务配置由 Java 管理端保存并随执行快照下发。
# 技术超时、安全上限、并发数和 Kafka Topic 使用代码内校验默认值，部署有差异时再按需覆盖。
AI_ENVIRONMENT=dev

# 必填：与 Java 的 AI_INTERNAL_SERVICE_TOKEN 保持完全一致。
AI_INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
# 必填：与 Java 的 AI_INTERNAL_SIGNING_KEY 保持完全一致。
AI_INTERNAL_SIGNING_KEY=replace-with-a-random-hmac-signing-key

# 必填：凭证别名映射；普通模型填写 API Key，火山知识库 Rerank 填写 AK/SK 对象。
# 管理端模型 credential_key 只保存这里的别名，不保存真实密钥。
# MCP Server 的 BEARER 认证也复用本字典：管理端 credentialKey 填别名，此处增加同名密钥。
# MCP Server 的 NONE 认证无需增加条目；不要把真实密钥保存在管理端或请求体。
AI_PROVIDER_CREDENTIALS={"doubao-api-key":"replace-with-doubao-api-key","aliyun-api-key":"replace-with-aliyun-api-key","doubao-rerank-aksk":{"accessKeyId":"replace-with-volcengine-ak","secretAccessKey":"replace-with-volcengine-sk"}}

# Python Worker 调用 Java 受控资源接口。
AI_JAVA_INTERNAL_BASE_URL=http://127.0.0.1:6039
# Qdrant 服务地址；启用认证时额外设置 AI_QDRANT_API_KEY。
AI_QDRANT_URL=http://127.0.0.1:6333
# AI_QDRANT_API_KEY=

# Kafka 只承载知识库后台任务；普通聊天仍使用 HTTP/SSE。
AI_KAFKA_ENABLED=true
AI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
