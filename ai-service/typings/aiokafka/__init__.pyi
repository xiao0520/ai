"""aiokafka 0.14 无 py.typed；只声明本服务使用且已核对的公共 SDK 签名。"""

from collections.abc import Iterable
from ssl import SSLContext
from aiokafka.structs import ConsumerRecord, RecordMetadata, TopicPartition

class ConsumerRebalanceListener:
    async def on_partitions_revoked(self, revoked: set[TopicPartition]) -> None: ...
    async def on_partitions_assigned(self, assigned: set[TopicPartition]) -> None: ...

class AIOKafkaConsumer:
    def __init__(self, *topics: str, bootstrap_servers: str, group_id: str,
        client_id: str, enable_auto_commit: bool, auto_offset_reset: str,
        max_poll_interval_ms: int, max_poll_records: int, request_timeout_ms: int,
        security_protocol: str, sasl_mechanism: str, sasl_plain_username: str | None,
        sasl_plain_password: str | None, ssl_context: SSLContext | None,
        max_partition_fetch_bytes: int) -> None: ...
    async def start(self) -> None: ...
    async def stop(self) -> None: ...
    async def getone(self) -> ConsumerRecord: ...
    async def commit(self, offsets: dict[TopicPartition, int]) -> None: ...
    def subscribe(self, topics: Iterable[str], listener: ConsumerRebalanceListener | None = ...) -> None: ...
    def assignment(self) -> set[TopicPartition]: ...
    async def end_offsets(self, partitions: Iterable[TopicPartition]) -> dict[TopicPartition, int]: ...
    async def position(self, partition: TopicPartition) -> int: ...
    async def getmany(self, *, timeout_ms: int, max_records: int) -> dict[TopicPartition, list[ConsumerRecord]]: ...

class AIOKafkaProducer:
    def __init__(self, *, bootstrap_servers: str, client_id: str,
        enable_idempotence: bool, acks: str, request_timeout_ms: int,
        security_protocol: str, sasl_mechanism: str, sasl_plain_username: str | None,
        sasl_plain_password: str | None, ssl_context: SSLContext | None,
        max_request_size: int) -> None: ...
    async def start(self) -> None: ...
    async def stop(self) -> None: ...
    async def send_and_wait(self, topic: str, value: bytes, key: bytes | None = ...) -> RecordMetadata: ...