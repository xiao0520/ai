  "paths": {
    "/internal/knowledge/jobs/{id}/artifact-tickets": {
      "post": {
        "operationId": "issueArtifactTicket",
        "tags": [
          "Python → Java"
        ],
        "x-implemented": true,
        "description": "Java 已实现任务绑定的 READ_SOURCE 与 WRITE_MANIFEST 票据。",
        "security": [
          {
            "InternalServiceToken": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-AI-Signature-Version",
            "required": true,
            "schema": {
              "type": "string",
              "const": "2"
            }
          },
          {
            "in": "header",
            "name": "X-AI-Timestamp",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          {
            "in": "header",
            "name": "X-AI-Nonce",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          },
          {
            "in": "header",
            "name": "X-AI-Signature",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/ArtifactTicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；直接返回 DTO，不包装 Java R 对象。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/ArtifactTicketResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/InternalError"
                }
              }
            }
          },
          "403": {
            "description": "内部认证或授权拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/InternalError"
                }
              }
            }
          },
          "409": {
            "description": "租约、版本或幂等冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/InternalError"
                }
              }
