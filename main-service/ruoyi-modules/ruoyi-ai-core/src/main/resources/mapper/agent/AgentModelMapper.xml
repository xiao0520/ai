<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ruoyi.mapper.agent.AgentModelMapper">

    <select id="countByModelIds" resultType="long">
        SELECT COUNT(1)
        FROM agent_model
        WHERE model_id IN
        <foreach collection="modelIds" item="modelId" open="(" separator="," close=")">
            #{modelId}
        </foreach>
    </select>

    <delete id="deleteByAgentIds">
        DELETE FROM agent_model
        WHERE agent_id IN
        <foreach collection="agentIds" item="agentId" open="(" separator="," close=")">#{agentId}</foreach>
    </delete>
    <select id="selectEnabledModelIdsByAgentId" resultType="java.lang.Long">
        SELECT model_id FROM agent_model WHERE agent_id = #{agentId} AND status = #{status}
        ORDER BY is_default DESC, model_id ASC
    </select>
</mapper>
