<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ruoyi.mapper.chat.ChatSessionSummaryMapper">

    <sql id="summaryColumns">
        id, session_id, covered_message_seq, summary_content, summary_tokens,
        model_id, status, create_dept, create_by, create_time, update_by, update_time
    </sql>

    <select id="selectActiveBySessionId" resultType="org.ruoyi.domain.entity.chat.ChatSessionSummary">
        SELECT <include refid="summaryColumns"/>
        FROM chat_session_summary
        WHERE session_id = #{sessionId}
          AND status = #{activeStatus}
    </select>

    <select id="selectBySessionId" resultType="org.ruoyi.domain.entity.chat.ChatSessionSummary">
        SELECT <include refid="summaryColumns"/>
        FROM chat_session_summary
        WHERE session_id = #{sessionId}
    </select>
</mapper>
