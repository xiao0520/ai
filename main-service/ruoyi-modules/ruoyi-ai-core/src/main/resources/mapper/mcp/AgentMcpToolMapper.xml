<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ruoyi.mapper.mcp.AgentMcpToolMapper">

    <select id="countByToolIds" resultType="long">
        SELECT COUNT(1)
        FROM agent_mcp_tool
        WHERE tool_id IN
        <foreach collection="toolIds" item="toolId" open="(" separator="," close=")">
            #{toolId}
        </foreach>
    </select>

    <select id="selectEnabledToolIdsByAgentId" resultType="java.lang.Long">
        SELECT tool_id
        FROM agent_mcp_tool
        WHERE agent_id = #{agentId}
          AND status = #{status}
        ORDER BY tool_id ASC
    </select>

    <delete id="deleteByAgentIds">
        DELETE FROM agent_mcp_tool
        WHERE agent_id IN
        <foreach collection="agentIds" item="agentId" open="(" separator="," close=")">#{agentId}</foreach>
    </delete>
</mapper>
